# Development repository export hygiene.
# The authoritative AstrBot distribution is the generated `runtime` branch.
# Runtime user files such as README.md and _conf_schema.json are intentionally
# NOT export-ignored because the default-archive/runtime equivalence gate must
# see exactly what users receive.

.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
evidence/ export-ignore
governance/ export-ignore
strategy/ export-ignore
model_cards/ export-ignore
assets/ export-ignore
tools/ export-ignore
AGENTS.md export-ignore
ARCHITECTURE.md export-ignore
capabilities/README.md export-ignore
.gitignore export-ignore
.gitattributes export-ignore

__pycache__/ export-ignore
*.pyc export-ignore
*.pyo export-ignore
.pytest_cache/ export-ignore
.coverage export-ignore
coverage.xml export-ignore

* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
