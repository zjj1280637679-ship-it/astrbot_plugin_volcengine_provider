{
  "schema_version": 1,
  "scope": "astrbot_plugin_volcengine_provider",
  "epistemic_contract": {
    "feedback_is_truth": false,
    "missing_feedback_means_unsupported": false,
    "feedback_may_prove_end_to_end_path": false,
    "historical_feedback_may_override_live_feedback": false,
    "current_conditions_may_define_future_capability": false,
    "model_id_alone_is_capability_authority": false
  },
  "future_extension_policy": {
    "allow_new_feedback_sources": true,
    "allow_new_capability_discovery_protocols": true,
    "allow_user_intentional_override": true,
    "require_source_declaration": true,
    "require_evidence_lifetime_declaration": true,
    "require_authority_scope_declaration": true,
    "forbid_unattributed_capability_fact": true,
    "preserve_unknown_future_feedback_tokens": true,
    "note": "The current implementation does not predict what future providers or AstrBot versions can know. New mechanisms are allowed when their information source and authority are explicit."
  },
  "fields": {
    "volcengine_video_input_enabled": {
      "kind": "request_transport_switch",
      "scope": "one_model_card",
      "authoritative_for": [
        "whether_the_volcengine_adapter_attempts_to_forward_current_video_as_ark_video_url"
      ],
      "not_authoritative_for": [
        "model_supports_video",
        "model_does_not_support_video",
        "provider_supports_video_for_all_models",
        "routing_or_fallback_selection"
      ],
      "false_means": "do_not_forward_video_payload_for_this_card",
      "false_does_not_mean": "model_unsupported",
      "migration_semantics": "preserve_previous_user_transport_intent_only"
    },
    "volcengine_video_controls_visible": {
      "kind": "retired_source_page_presentation_preference",
      "scope": "legacy_owned_provider_source_config_only",
      "authoritative_for": [
        "whether_the_source_page_per_model_video_selector_is_visible"
      ],
      "not_authoritative_for": [
        "whether_any_model_card_forwards_video",
        "model_supports_video",
        "model_does_not_support_video",
        "provider_supports_video_for_all_models",
        "routing_or_fallback_selection"
      ],
      "false_means": "hide_selector_and_preserve_all_per_card_transport_values",
      "persistent": false,
      "retired_in": "0.1.20",
      "runtime_transport_authority": false
    }
  },
  "dashboard_transport_ui": {
    "surface": "current_model_dialog_private_schema_clone",
    "canonical_field_in_shared_schema": false,
    "canonical_field_in_generic_model_card_projection": true,
    "owned_sources_only": true,
    "identity_boundary": "selected_provider_source_type_after_private_schema_clone",
    "persistent_visibility_field": null,
    "visibility_field_authority": "selected_source_type_only",
    "temporary_selector_key_prefix": "_volcengine_video_models_ui_",
    "temporary_selector_key_encoding": "source_id_utf8_hex_reversible_injective",
    "temporary_selector_identity": "exact_model_card_ids_belonging_to_current_source",
    "temporary_selector_condition": null,
    "temporary_selector_persistent": false,
    "save_boundary_action": "mirror_explicit_video_membership_in_owned_card_modalities_to_per_card_volcengine_video_input_enabled",
    "hidden_or_omitted_selector_action": "not_applicable_current_ui",
    "runtime_truth": "per_card_modalities_video_and_compatibility_mirror_volcengine_video_input_enabled",
    "foreign_provider_visibility": false,
    "foreign_ui_key_can_create_plugin_state": false,
    "requires_host_apis": [
      "get_provider_schema",
      "create_provider",
      "update_provider",
      "static_file_resolver"
    ],
    "missing_required_host_api": "skip_optional_model_field_ui_without_blocking_provider_registration",
    "legacy_open_model_dialog_compatibility": {
      "temporary_key_prefix": "_volcengine_video_transport_ui_",
      "promotion_eligibility": "boolean_value_on_owned_card_whose_key_encodes_that_cards_exact_provider_source_id",
      "wrong_source_or_foreign_key_can_create_plugin_state": false,
      "save_boundaries": [
        "create_provider",
        "update_provider"
      ],
      "visible_entry_point": false,
      "purpose": "translate_and_strip_a_stale_already_open_0_1_17_model_dialog"
    },
    "source_save_failure_action": "legacy_0_1_18_compatibility_only",
    "service_validation": {
      "astrbot_4_26_1": "L3_pass",
      "astrbot_4_27_2": "L3_pass",
      "current_dashboard_presentation": {
        "status": "L4_pass",
        "astrbot_version": "4.27.2",
        "observed_date": "2026-08-12",
        "owned_source_masters": {
          "ark": 1,
          "agent_plan": 1
        },
        "owned_source_selectors": {
          "ark": 1,
          "agent_plan": 1
        },
        "selector_card_counts": {
          "ark": 2,
          "agent_plan": 1
        },
        "selector_scope": "current_source_only",
        "close_hides_selector": true,
        "reopen_preserves_selection": true,
        "interaction_api_request_count": 0,
        "foreign_source_master_count": 0,
        "foreign_source_selector_count": 0,
        "generic_model_dialog_plugin_video_fields": {
          "ark": 0,
          "agent_plan": 0,
          "foreign": 0
        },
        "page_errors": []
      }
    },
    "note": "AstrBot 4.26/4.27 uses one shared generic model-card schema. The Source form owns reliable provider identity, so the selector is projected there while runtime truth remains per card."
  },
  "live_model_feedback": {
    "ordinary_ark_models_receipt": {
      "source": "current_ordinary_ark_/models_receipt",
      "scope": "provider_source_plus_model_id",
      "lifetime": "single_dashboard_model_list_call",
      "storage": "async_context_single_use_handoff",
      "persistent": false,
      "missing_field": "not_reported",
      "explicit_false": "current_feedback_false_not_model_truth",
      "explicit_empty_list": "current_feedback_empty_not_missing",
      "explicit_integer_zero": "current_feedback_zero_not_missing",
      "unknown_modality_token": "preserve_as_information_do_not_interpret_or_filter",
      "display_rule": "explicit_current_fields_may_replace_same_display_field_for_this_response_only",
      "global_metadata_mutation": false,
      "routing_authority": false
    },
    "agent_plan_model_names": {
      "source": "discovery_candidates_only",
      "capability_feedback": false,
      "routing_authority": false
    }
  },
  "failure_domains": {
    "input_transport": {
      "meaning": "media_failed_before_a_valid_request_reached_ark_model",
      "reached_model": false,
      "model_capability_observed": null,
      "persist_as_capability": false,
      "routing_advice": null,
      "routing_owner": "AstrBot_or_user"
    },
    "upstream_response": {
      "meaning": "request_reached_upstream_and_upstream_returned_a_response_or_error",
      "reached_model_or_upstream": true,
      "model_capability_inference": "only_if_the_upstream_receipt_explicitly_says_so_and_even_then_it_is_feedback_not_eternal_truth",
      "routing_advice": null,
      "routing_owner": "AstrBot_or_user"
    }
  },
  "migration_precedence": [
    "current_per_card_volcengine_video_input_enabled",
    "exact_source_retired_0_1_17_model_ui_boolean",
    "legacy_per_card_volcengine_model_video_input",
    "legacy_explicit_source_boolean_including_false",
    "historical_modalities_video_clue"
  ],
  "migration_cleanup_contract": {
    "retired_0_1_17_ui_key_prefix": "_volcengine_video_transport_ui_",
    "retired_ui_key_must_match_card_provider_source_id": true,
    "retired_ui_value_must_be_boolean": true,
    "wrong_source_retired_ui_may_be_promoted": false,
    "foreign_card_plugin_video_state_may_be_promoted": false,
    "remove_all_retired_and_temporary_ui_keys_after_resolution": true,
    "remove_source_only_video_fields_from_model_cards": true,
    "remove_model_only_and_temporary_video_fields_from_sources": true,
    "owned_source_visibility_field_may_persist": false,
    "foreign_source_visibility_field_may_persist": false,
    "modalities_mutation": "owned_model_card_explicit_user_configuration_only"
  },
  "display_contract": {
    "unknown": "no_plugin_claim",
    "not_reported": "no_plugin_claim",
    "reported": "show_as_feedback_only",
    "old_plugin_dynamic_feedback": "must_not_be_reused_as_current_feedback"
  }
}
